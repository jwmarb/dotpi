{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "fallback",
  "defaultModel": "auto",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "steeringMode": "all",
  "extensions": [
    "+builtin:mcp",
    "+builtin:codemode",
    "-builtin:llama.cpp",
    "-builtin:tool-search",
    "-builtin:herdr"
  ],
  "images": {
    "autoResize": true
  },
  "theme": "tokyo-night",
  "retry": {
    "enabled": true,
    "maxRetries": 40,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "modelFallback": {
    "chain": [
      "qwen/qwen3.8-flash-next|xhigh",
      {
        "model": "anthropic/claude-opus-5.5",
        "thinking": "low"
      },
      {
        "model": "anthropic/claude-opus-5",
        "thinking": "low"
      },
      "openai/gpt-5.6-sol"
    ],
    "maxCycles": 10,
    "maxProbes": 2,
    "contextWindow": 262144,
    "maxTokens": 32768
  },
  "packages": [
    "git:github.com/samfoy/pi-lsp-extension",
    "npm:@ff-labs/pi-fff",
    "npm:pi-better-edit",
    "npm:pi-blackhole",
    {
      "source": "git:github.com/obra/superpowers",
      "extensions": [
        "-.pi/extensions/superpowers.ts"
      ]
    }
  ],
  "quietStartup": true,
  "startupFetch": {
    "mode": "cycle",
    "style": "pixels",
    "height": 13
  },
  "piBolt": {
    "packages": [
      "-npm:@ff-labs/pi-fff",
      "npm:opensec-pi-fff@0.11.1"
    ],
    "packagesOverlay": true
  }
}
