{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "robinhood": {
      "url": "https://agent.robinhood.com/mcp/trading",
      "oauth": {
        "clientName": "pi"
      },
      "description": "Robinhood trading: account positions, quotes, and order history.",
      "timeout": 60
    }
  }
}
