# Credentials for pi extensions. See docs/adr/0042.
#
# Copy this file to agent/.env and replace the placeholders with real keys:
#     cp agent/.env.example agent/.env
# The real agent/.env is gitignored and never committed.

# Provider key used by agent/extensions/litellm.ts (Authorization: Bearer <key>).
LITELLM_API_KEY=sk-your-litellm-provider-key

# Provider base URL used by agent/extensions/litellm.ts.
LITELLM_BASE_URL=https://your-litellm-gateway/v1

# Firecrawl endpoint used by agent/extensions/firecrawl-cli.ts, read by the
# `firecrawl` CLI (firecrawl-cli) that the librarian agent researches with.
#
# No API key is needed: any non-default URL makes the CLI skip key validation,
# so a self-hosted instance authenticates however it wants. Prefer a plain
# credential-free endpoint; if yours is behind basic auth, put the userinfo in
# the URL (`https://user:pass@host`) and the CLI sends it as Authorization: Basic.
FIRECRAWL_API_URL=http://your-firecrawl-host:3002

# GitHub personal access token used by the `github` MCP server in
# agent/mcp.json (https://api.githubcopilot.com/mcp/,
# Authorization: Bearer <token>). Pi expands ${GITHUB_TOKEN} from the
# environment when the server connects; a classic PAT (ghp_…) is accepted.
GITHUB_TOKEN=ghp-your-github-personal-access-token
