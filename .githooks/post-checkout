#!/usr/bin/env bash
#
# Re-verify extension dependencies after the tree changes.
#
# node_modules/ is git-ignored, so the dependencies do not travel with the
# clone. post-checkout fires when branches (and with them package-lock.json)
# may have changed; the initial clone is covered by
# agent/extensions/git-hooks.ts at startup, which no git hook sees.
#
# Best-effort: a missing npm or a failed install prints a warning and moves
# on — a hook failure must not block the checkout.
#
# A file checkout ($3 = 0) cannot have changed the lockfile; skip it.
[ "${3:-1}" = "0" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 0
[ -x "$root/scripts/setup-deps.sh" ] || exit 0
bash "$root/scripts/setup-deps.sh" --force
exit 0
