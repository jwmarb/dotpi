#!/usr/bin/env bash
#
# Refuse a commit whose extension sources cannot load.
#
# Installed by pointing git at this tracked directory:
#
#     git config core.hooksPath .githooks
#
#
# pi does that for you: agent/extensions/git-hooks.ts self-arms this hook on
# every startup (and warns loudly when core.hooksPath points elsewhere), so a
# fresh clone is guarded from its first commit. The manual command remains for
# shells that never go through pi.
# That indirection is the point. A hook in `.git/hooks/` is not version
# controlled, so it silently does not exist on a fresh clone — the failure mode
# being guarded against here is *silence*, so the guard must not itself be
# silently absent.
#
# Why a hook rather than a habit: a commit once shipped `dynamic-prompt.ts` with
# bare backticks inside a template literal, which made the file unparseable and
# stopped pi from starting the extension. The rest of that commit had been
# checked thoroughly. The file edited last was never loaded even once. Relying on
# remembering to run a script has exactly the same weakness as the habit it
# replaces.
#
# Bypass a single commit with `git commit --no-verify` when you genuinely need to.
set -uo pipefail

# Only worth running when a TypeScript source is actually part of this commit.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^agent/extensions/.*\.ts$'; then
	exit 0
fi

root=$(git rev-parse --show-toplevel)
check="$root/scripts/check.sh"

# A missing guard is a failure, not a pass. This used to be `|| exit 0`, and when
# `scripts/check.sh` was deleted in 7a54a3b as collateral damage the hook went on
# exiting 0 for every commit after it — silently, while `git-hooks.ts` kept
# telling the user their commits were protected against unloadable sources. The
# whole argument above is that the failure mode being guarded is *silence*, so a
# guard that can disappear quietly defeats itself. Fail loudly instead: a real
# absence is then a two-second fix rather than an invisible regression.
if [ ! -x "$check" ]; then
	echo "Commit refused: $check is missing or not executable." >&2
	echo "It is the one check that a committed source actually loads — pi dies at" >&2
	echo "startup on a file that cannot be parsed, before it can say which one." >&2
	echo "Restore it (git log -- scripts/check.sh), or bypass with --no-verify." >&2
	exit 1
fi

# CHECK_STAGED=1: check.sh materialises the index in a scratch dir and checks
# that — what the commit records — not the working tree. A partially staged
# file can therefore not pass here and ship broken.
if ! CHECK_STAGED=1 "$check"; then
	echo
	echo "Commit refused: the checks above failed."
	echo "A file that cannot load takes pi's startup with it — fix it, or use --no-verify."
	exit 1
fi
